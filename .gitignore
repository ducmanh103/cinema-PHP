# ================================================================
# Minimal .gitignore - chỉ loại rác OS / IDE / logs
# Toàn bộ source (WordPress core, themes, plugins, uploads, wp-config) đều commit
# ================================================================

# Logs
*.log
error_log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user

# Temp / backup
*.bak
*.tmp
*.old
*.orig

# Node
node_modules/
